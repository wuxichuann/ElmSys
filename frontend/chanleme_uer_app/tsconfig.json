{
  "compilerOptions": {
    "target": "ESNext", // 确保目标是现代的 ES 版本
    "useDefineForClassFields": true,
    "module": "ESNext", // 或者 "NodeNext"，确保 TypeScript 处理模块的方式支持 ESM
    "moduleResolution": "bundler", // 推荐使用 "bundler"，或者 "node16" / "NodeNext"
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, // 跳过库的类型检查，加快编译速度
    "baseUrl": ".", // 配置 @ 别名解析的基础路径
    "paths": {
      "@/*": ["src/*"] // 配置 @ 别名
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts", // 确保包含所有 .d.ts 文件，包括 shims-vue.d.ts
    "src/**/*.tsx",
    "src/**/*.vue", // 确保包含 .vue 文件
    "env.d.ts", // Vite 会生成这个文件
    "vite.config.ts" // 包含 vite.config.ts 到类型检查中
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}